---
import { Font } from "astro:assets";
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Systems-oriented engineer building performant tools, system utilities, and backend infrastructure in Rust, C, and TypeScript." />
    <meta property="og:site_name" content="Amartya Chowdhury | Software Engineer & Rust Developer" />
    <meta property="og:title" content="Amartya Chowdhury | Software Engineer & Rust Developer" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://amarch.vercel.app/" />
    <meta property="og:description" content="Systems-oriented engineer building performant tools, system utilities, and backend infrastructure in Rust, C, and TypeScript." />
    <meta property="og:image" content="/landing-og.webp">
    <meta property="og:image:alt" content="Amartya Chowdhury - Developing solutions to everyone's problems">
    <meta name="twitter:card" content="summary_large_image" />
    <link 
      rel="icon" 
      type="image/svg+xml" 
      href="/favicon-light.svg" 
      media="(prefers-color-scheme: light)" 
    />
    <link 
      rel="icon" 
      type="image/svg+xml" 
      href="/favicon-dark.svg" 
      media="(prefers-color-scheme: dark)" 
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>Amartya Chowdhury | Software Engineer & Rust Developer</title>
  </head>
  <body>

    <Font cssVariable="--font-lora" />
    <Font cssVariable="--font-spacegrotesk" />
    <Font cssVariable="--font-spacemono" />

    <!-- Loading overlay -->
    <div id="site-loader" class="fixed inset-0 bg-bg z-50 flex items-center justify-center transition-opacity duration-500 ease-out"></div>

    <slot />

  </body>
</html>

<script>
const body = document.body;
const loader = document.getElementById('site-loader');
const hasHero = !!document.getElementById('hero-name');

let pageLoaded = document.readyState === 'complete';
let minTimePassed = false;
let exited = false;

function tryExit() {
  if (exited || !pageLoaded || !minTimePassed) return;
  exited = true;

  body.classList.remove('is-loading');

  if (loader) {
    loader.style.opacity = '0';
    setTimeout(() => loader.remove(), 600); // matches duration-500
  }

  // tell the Hero it can fly the name into place
  window.dispatchEvent(new Event('site-ready'));
}

if (!pageLoaded) {
  window.addEventListener('load', () => {
    pageLoaded = true;
    tryExit();
  });
}

// no point holding the splash on pages without the hero
setTimeout(() => {
  minTimePassed = true;
  tryExit();
}, hasHero ? 1000 : 0);
</script>

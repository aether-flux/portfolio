<script>
  const name = document.getElementById('hero-name') as HTMLElement | null;
  const ghost = document.getElementById('hero-name-ghost') as HTMLElement | null;
  const slot = document.getElementById('logo-slot') as HTMLElement | null;
  const copyKittyBtn = document.getElementById('copy-kitty-palette') as HTMLElement | null;
  const copyToast = document.getElementById('copy-toast') as HTMLElement | null;

  if (name && ghost && slot) {
    let dx = 0, dy = 0, scale = 1, range = 1;

    const measure = () => {
      name.style.transform = 'none';

      const g = ghost.getBoundingClientRect();
      const s = slot.getBoundingClientRect();
      const startTop = g.top + window.scrollY; // where it sits at scrollY = 0

      // pin the h1 exactly over the ghost
      name.style.left = `${g.left}px`;
      name.style.top = `${startTop}px`;

      dx = s.left - g.left;
      dy = s.top - startTop;
      scale = Math.min(
        s.height / name.offsetHeight,
        s.width / name.offsetWidth
      );
      range = window.innerHeight * 0.4; // finishes after 40% viewport scroll
    };

    const update = () => {
      const p = Math.min(Math.max(window.scrollY / range, 0), 1);
      const sc = 1 - (1 - scale) * p;
      name.style.transform = `translate3d(${dx * p}px, ${dy * p}px, 0) scale(${sc})`;
    };

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true }
    );

    window.addEventListener('resize', () => {
      measure();
      update();
    });

    document.fonts.ready.then(() => {
      measure();
      update();
    });
  }

  // Copy Kitty color palette
  const kittyConfig = `
background #191715
foreground #CDC4BA

color0  #191715
color1  #D9534F
color2  #7EA37B
color3  #F37216
color4  #6C8EA4
color5  #A8829E
color6  #78A3A3
color7  #CDC4BA

color8  #3D3834
color9  #E57373
color10 #A2C49F
color11 #FF8533
color12 #8FAEC4
color13 #CBA3C1
color14 #9EC4C4
color15 #EFEAE6
`.trim();

  if (copyKittyBtn && copyToast) {
    copyKittyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(kittyConfig);
        copyToast.classList.remove('opacity-0');
        copyToast.classList.add('opacity-100');

        setTimeout(() => {
          copyToast.classList.remove('opacity-100');
          copyToast.classList.add('opacity-0');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy kitty config: ', e);
      }
    })
  }
</script>

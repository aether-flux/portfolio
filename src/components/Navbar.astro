---
const { notHome } = Astro.props;
---
<header id="nav" class="fixed top-0 left-0 w-full z-50 px-6 md:px-20 py-6 bg-bg border-b border-border">
  <div class="flex justify-between items-center">
    
    <div id="logo-slot" class="h-12 w-32 flex items-center">{notHome ? (
      <h1
        class="fixed z-[60] origin-top-left will-change-transform font-serif text-lg md:text-xl text-primary italic leading-[1.1] transition-colors duration-300 hover:text-accent"
      >
        <a href="/">Amartya<br/>Chowdhury</a>
      </h1>
    ) : ""}</div>

    <nav class="hidden md:flex items-center gap-8 font-sans text-md text-primary">
      <a href="#about" class="nav-link hover:text-accent transition-colors">About</a>
      <a href="#skills" class="nav-link hover:text-accent transition-colors">Skills</a>
      <a href="#work" class="nav-link hover:text-accent transition-colors">Work</a>
      <a href="#contact" class="nav-link hover:text-accent transition-colors">Contact</a>
    </nav>

    <button id="menu-btn" aria-label="Toggle Menu" class="md:hidden p-2 text-primary focus:outline-none z-50 cursor-pointer">
      <!-- Hamburger Icon -->
      <svg id="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 block">
        <path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>
      </svg>
      <!-- Close (X) Icon -->
      <svg id="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 hidden">
        <path d="M18 6L6 18"/><path d="M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div 
    id="mobile-menu" 
    class="fixed inset-x-0 top-[81px] bottom-0 bg-bg z-40 flex flex-col items-center justify-center gap-8 font-sans text-2xl text-primary md:hidden opacity-0 pointer-events-none -translate-y-4 transition-all duration-300 ease-in-out shadow-2xl"
  >
    <a href="#about" class="mobile-nav-link hover:text-accent transition-colors">About</a>
    <a href="#skills" class="mobile-nav-link hover:text-accent transition-colors">Skills</a>
    <a href="#work" class="mobile-nav-link hover:text-accent transition-colors">Work</a>
    <a href="#contact" class="mobile-nav-link hover:text-accent transition-colors">Contact</a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.contains('opacity-100');

    if (isOpen) {
      // Close menu animation state
      mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      mobileMenu?.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
      iconOpen?.classList.remove('hidden');
      iconOpen?.classList.add('block');
      iconClose?.classList.remove('block');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = ''; // Restore scrolling
    } else {
      // Open menu animation state
      mobileMenu?.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
      mobileMenu?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      iconOpen?.classList.remove('block');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      iconClose?.classList.add('block');
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
    }
  }

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', toggleMenu);

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        // Close menu smoothly when a link is clicked
        toggleMenu();
      });
    });
  }
</script>

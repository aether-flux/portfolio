const body = document.body;
const loader = document.getElementById('site-loader');
const hasHero = !!document.getElementById('hero-name');

let pageLoaded = document.readyState === 'complete';
let minTimePassed = false;
let exited = false;

function tryExit() {
  if (exited || !pageLoaded || !minTimePassed) return;
  exited = true;

  body.classList.remove('is-loading');

  if (loader) {
    loader.style.opacity = '0';
    setTimeout(() => loader.remove(), 600); // matches duration-500
  }

  // tell the Hero it can fly the name into place
  window.dispatchEvent(new Event('site-ready'));
}

if (!pageLoaded) {
  window.addEventListener('load', () => {
    pageLoaded = true;
    tryExit();
  });
}

// no point holding the splash on pages without the hero
setTimeout(() => {
  minTimePassed = true;
  tryExit();
}, hasHero ? 1000 : 0);
</script>

<section id="about" class="relative md:min-h-screen pt-32 px-6 max-w-6xl mx-auto flex flex-col justify-center">
    <!-- Left Column -->
    <div class="space-y-6">
      <h1 
        class="font-serif text-5xl md:text-7xl text-primary italic leading-[1.1] origin-top-left transition-transform duration-75 will-change-transform"
      >
        About Me
      </h1>

      <div class="grid grid-cols-[auto_auto_1fr] items-baseline gap-3 font-mono text-sm md:text-lg leading-[1.4] text-secondary">
        <div class="w-2.5 h-2.5 bg-primary"></div>
        <span class="text-border">[location]</span>
        <span>West Bengal, India</span>

        <div class="w-2.5 h-2.5 bg-primary"></div>
        <span class="text-border">[education]</span>
        <span>Final-year CS student</span>

        <div class="w-2.5 h-2.5 bg-primary"></div>
        <span class="text-border">[work]</span>
        <span>Dive into rabbit-holes and solve actual problems with my creations</span>
      </div>
    </div>
</section>

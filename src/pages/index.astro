---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import HeroImage from "../components/HeroImage.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
---

<BaseLayout>
	<Navbar />

	<section class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12">
  	<!-- scrolling column -->
  	<div>
    	<Hero />
    	<About />
  	</div>

  	<!-- pinned column -->
  	<aside class="">
    	<div class="md:sticky md:top-0 md:h-screen flex items-center justify-end pt-0 md:pt-24">
      	<HeroImage />
    	</div>
  	</aside>
	</section>

	<Skills />
</BaseLayout>
